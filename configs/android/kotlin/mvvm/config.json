{
  "name": "Android — Kotlin MVVM",
  "tags": ["android", "kotlin", "mvvm", "jetpack-compose", "hilt", "retrofit", "room"],
  "description": "Android application with MVVM architecture, Jetpack Compose UI, Hilt dependency injection, Retrofit for networking, and Room for local persistence.",

  "structure": {
    "type": "android-app",
    "data": {
      "folders": ["dto", "local", "remote", "repository"]
    },
    "di": {
      "templates": ["kotlin_app-module"]
    },
    "domain": {
      "folders": ["model", "repository", "usecase"]
    },
    "ui": {
      "folders": [
        "screens",
        { "core": { "templates": ["kotlin_ui_core"] } }
      ]
    }
  },

  "code_conventions": {
    "editorconfig": true,
    "linter": {
      "enabled": true,
      "type": "ktlint",
      "config_file": ".editorconfig"
    },
    "formatter": {
      "enabled": true,
      "type": "ktlint"
    },
    "commit_conventions": {
      "enabled": true,
      "tool": "commitlint",
      "config_file": "commitlint.config.js",
      "hooks": "husky"
    }
  }
}
