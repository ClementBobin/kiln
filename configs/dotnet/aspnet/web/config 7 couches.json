{
  "name": "Config 7 Couches",
  "description": "Web API with Clean Architecture layers: Business, Business.Contracts, Entity, EntitiesContext, Repository, Repository.Contracts, WebApplications",
  "version": "1.0.0",
  "tags": ["dotnet", "aspnet", "web", "clean-archi"],

  "structure": {
    "WebApplications": {
      "type": "web-api",
      "folders": ["Configuration", "Controllers", "Extensions", "Interceptors", "Middleware"],
      "references": ["Business", "Business.Contracts", "Repository", "Repository.Contracts", "Entity"]
    },
    "WebApplications.Tests": {
      "type": "unit-test",
      "lib": "xunit",
      "references": ["WebApplications", "Business.Contracts"]
    },
    "Business": {
      "type": "classlib",
      "folders": ["Seeds"],
      "references": ["Business.Contracts", "Entity", "Repository.Contracts"]
    },
    "Business.Contracts": {
      "type": "classlib",
      "folders": ["DTO"],
      "references": ["Entity"]
    },
    "Business.Tests": {
      "type": "unit-test",
      "lib": "xunit",
      "references": ["Business", "Business.Contracts"]
    },
    "Entity": {
      "type": "classlib",
      "folders": ["Fixtures"]
    },
    "EntitiesContext": {
      "type": "classlib",
      "references": ["Entity"]
    },
    "Repository": {
      "type": "classlib",
      "references": ["Repository.Contracts", "Entity", "EntitiesContext"]
    },
    "Repository.Contracts": {
      "type": "classlib",
      "references": ["Entity"]
    },
    "Repository.Tests": {
      "type": "unit-test",
      "lib": "xunit",
      "references": ["Repository", "Entity", "EntitiesContext"]
    }
  },

  "variables": [
    { "key": "project_name",   "label": "Project name",   "default": "MyApi" },
    { "key": "dotnet_version", "label": ".NET version",   "choices": ["8", "9", "10"], "default": "8" },
    { "key": "enable_test",    "label": "Enable testing", "choices": ["true", "false"], "default": "false" }
  ],

  "code_conventions": {
    "editorconfig": true,
    "linter":     { "enabled": true, "type": "roslyn", "config_file": ".editorconfig" },
    "formatter":  { "enabled": true, "type": "dotnet-format" },
    "commit_conventions": { "enabled": true, "tool": "commitlint", "config_file": "commitlint.config.js", "hooks": "husky" }
  }
}
