{
  "name": "Config 4 Couches",
  "description": "Web API with Clean Architecture layers: Domain, Application, Infrastructure, WebApplications",
  "version": "1.0.0",
  "tags": ["dotnet", "aspnet", "web", "clean-archi"],

  "structure": {
    "WebApplications": {
      "type": "web-api",
      "folders": ["Configuration", "Controllers", "Extensions", "Interceptors", "Middleware"],
      "references": ["Application", "Domain", "Infrastructure"]
    },
    "WebApplications.Tests": {
      "type": "unit-test",
      "lib": "xunit",
      "references": ["WebApplications", "Domain", "Application"]
    },
    "Application": {
      "type": "classlib",
      "folders": ["Interfaces", "Services"],
      "references": ["Domain", "Infrastructure"]
    },
    "Application.Tests": {
      "type": "unit-test",
      "lib": "xunit",
      "references": ["Domain", "Application", "Infrastructure"]
    },
    "Domain": {
      "type": "classlib",
      "folders": ["Dto", "Entities"]
    },
    "Infrastructure": {
      "type": "classlib",
      "folders": ["Data", "Interfaces", "Repositories"],
      "references": ["Domain"]
    },
    "Infrastructure.Tests": {
      "type": "unit-test",
      "lib": "xunit",
      "references": ["Domain", "Infrastructure"]
    }
  },

  "variables": [
    { "key": "project_name",   "label": "Project name",   "default": "MyApi" },
    { "key": "dotnet_version", "label": ".NET version",   "choices": ["8", "9", "10"], "default": "8" },
    { "key": "enable_test",    "label": "Enable testing", "choices": ["true", "false"], "default": "false" }
  ],

  "code_conventions": {
    "editorconfig": true,
    "linter":     { "enabled": true, "type": "roslyn", "config_file": ".editorconfig" },
    "formatter":  { "enabled": true, "type": "dotnet-format" },
    "commit_conventions": { "enabled": true, "tool": "commitlint", "config_file": "commitlint.config.js", "hooks": "husky" }
  }
}
