{
  "name": "Config 4 Couches",
  "description": "REST API with Clean Architecture layers (Domain, Application, Infrastructure, WebApplications)",
  "version": "1.0.0",
  "tags": ["dotnet", "aspnet", "web", "clean-archi"],

  "source": {
    "type": "command",
    "commands": [
      {
        "cmd": "dotnet new sln -n {{project_name}} -o {{project_name}}",
        "label": "Create solution"
      },
      {
        "cmd": "dotnet new webapi -o {{project_name}}/{{project_name}}.WebApplications -n {{project_name}}.WebApplications --framework net{{dotnet_version}}",
        "label": "Create WebApplications project"
      },
      {
        "cmd": "dotnet new classlib -o {{project_name}}/{{project_name}}.Application -n {{project_name}}.Application --framework net{{dotnet_version}}",
        "label": "Create Application project"
      },
      {
        "cmd": "dotnet new classlib -o {{project_name}}/{{project_name}}.Domain -n {{project_name}}.Domain --framework net{{dotnet_version}}",
        "label": "Create Domain project"
      },
      {
        "cmd": "dotnet new classlib -o {{project_name}}/{{project_name}}.Infrastructure -n {{project_name}}.Infrastructure --framework net{{dotnet_version}}",
        "label": "Create Infrastructure project"
      },
      {
        "cmd": "dotnet sln {{project_name}}/{{project_name}}.sln add {{project_name}}/{{project_name}}.WebApplications/{{project_name}}.WebApplications.csproj {{project_name}}/{{project_name}}.Application/{{project_name}}.Application.csproj {{project_name}}/{{project_name}}.Domain/{{project_name}}.Domain.csproj {{project_name}}/{{project_name}}.Infrastructure/{{project_name}}.Infrastructure.csproj",
        "label": "Add projects to solution"
      }
    ]
  },

  "structure": {
    "WebApplications": {
      "type": "web-api",
      "folders": ["Configuration", "Controllers", "Extensions", "Interceptors", "Middleware"],
      "references": ["Application", "Application.Tests", "Domain", "Infrastructure", "Infrastructure.Tests"]
    },
    "WebApplications.Tests": {
      "type": "unit-test",
      "references": ["WebApplications", "Domain", "Application"],
      "lib": "xunit"
    },
    "Application": {
      "type": "class-library",
      "folders": ["Interfaces", "Services"],
      "references": ["Domain", "Tools", "Infrastructure"]
    },
    "Application.Tests": {
      "type": "unit-test",
      "references": ["Domain", "Application", "Infrastructure"],
      "lib": "xunit"
    },
    "Domain": {
      "type": "class-library",
      "folders": ["Dto", "Entities"]
    },
    "Infrastructure": {
      "type": "class-library",
      "folders": ["Data", "Interfaces", "Repositories"],
      "references": ["Domain", "Tools"]
    },
    "Infrastructure.Tests": {
      "type": "unit-test",
      "lib": "xunit",
      "references": ["Domain", "Infrastructure"]
    }
  },

  "variables": [
    { "key": "project_name",   "label": "Project name",   "default": "MyApi" },
    { "key": "dotnet_version", "label": ".NET version",   "choices": ["8", "9", "10"], "default": "10" },
    { "key": "enable_test",    "label": "Enable testing", "choices": ["true", "false"], "default": "false" }
  ],

  "code_conventions": {
    "editorconfig": true,
    "linter": {
      "enabled": true,
      "type": "eslint",
      "config_file": ".editorconfig"
    },
    "formatter": {
      "enabled": true,
      "type": "prettier"
    },
    "commit_conventions": {
      "enabled": true,
      "tool": "commitlint",
      "config_file": "commitlint.config.js",
      "hooks": "husky"
    }
  },

  "post_init": [
    { "cmd": "dotnet restore {{project_name}}/{{project_name}}.sln", "label": "Restore NuGet packages" }
  ]
}